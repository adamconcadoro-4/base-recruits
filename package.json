{
  "name": "base-recruits",
  "version": "0.1.0",
  "private": true,
  "description": "Base Recruits — free academic discovery and college baseball recruiting platform.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:start": "scripts/db/local.sh start",
    "db:stop": "scripts/db/local.sh stop",
    "db:reset": "scripts/db/local.sh reset",
    "db:psql": "scripts/db/local.sh psql",
    "test:db": "scripts/db/test.sh",
    "test:race": "scripts/db/race-test.sh",
    "test:unit": "vitest run tests/unit",
    "test:contract": "scripts/db/local.sh reset && DATABASE_URL=\"postgresql://postgres@/base_recruits_test?host=$PWD/.local/run&port=54329\" vitest run tests/contract",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:db && npm run test:race && npm run test:contract",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
