# Copy to .env.local for development. Never commit real values.

# ---- Public (sent to the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production — design-only example cards render only outside production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Used for exactly one call today: recording the age-screen date of birth for a
# brand-new account (public.admin_record_birthdate).
SUPABASE_SECRET_KEY=
