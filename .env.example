# Copy to .env.local for development. Never commit real values.

# ---- Public (sent to the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | test | staging | production (test adds Supabase error codes to auth messages)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Service-role key. The app uses it for one thing: deleting an account after an
# under-13 answer. The end-to-end tests also use it to create test accounts.
SUPABASE_SECRET_KEY=

# ---- SeamState swing analysis (server only; leave empty until approved) ------
# AI provider key from the Anthropic organization with a monthly spend limit.
ANTHROPIC_API_KEY=
# Optional; defaults to DEFAULT_SEAMSTATE_MODEL in src/lib/seamstate/server/config.ts.
SEAMSTATE_MODEL=
# The worker's https address (Google Cloud Run) and the shared signing secret (32+ characters).
SEAMSTATE_WORKER_URL=
SEAMSTATE_WORKER_SECRET=
# Bearer secret Vercel Cron sends to /api/seamstate/dispatch.
CRON_SECRET=
